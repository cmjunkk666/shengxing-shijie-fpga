[
  {
    "id": "1_intro",
    "text": "林间鸟鸣，留意短促音节。"
  },
  {
    "id": "1_closing",
    "text": "每次鸣叫的间隔一样吗？"
  },
  {
    "id": "2_intro",
    "text": "池塘蛙鸣，听重复的叫声。"
  },
  {
    "id": "2_closing",
    "text": "你听出了什么节奏？"
  },
  {
    "id": "3_intro",
    "text": "山间流水，听连续的水声。"
  },
  {
    "id": "3_closing",
    "text": "它会像鸟鸣那样停顿吗？"
  },
  {
    "id": "4_intro",
    "text": "远处雷声，听低沉的滚动。"
  },
  {
    "id": "4_closing",
    "text": "雷声的起伏，和流水声一样吗？"
  }
]