--- before/src/user_source/hdl_source/key_events.v
+++ after/src/user_source/hdl_source/key_events.v
@@ -0,0 +1,119 @@
+// Two active-low keys; all logic stays in clk domain.
+// KEY1: short=next, long=cycle period. KEY2: short=auto, long=previous.
+module key_events #(
+    parameter integer CLK_FREQ_HZ = 100_000_000,
+    parameter integer DEBOUNCE_MS = 20,
+    parameter integer LONG_PRESS_MS = 1000
+)(
+    input wire clk,
+    input wire rst,
+    input wire key1_n,
+    input wire key2_n,
+    output reg next_event,
+    output reg prev_event,
+    output reg toggle_auto_event,
+    output reg cycle_period_event,
+    output wire interaction_active
+);
+localparam integer DB_CYCLES = ((CLK_FREQ_HZ / 1000) * DEBOUNCE_MS > 0)
+                            ? (CLK_FREQ_HZ / 1000) * DEBOUNCE_MS : 1;
+localparam integer HOLD_CYCLES = ((CLK_FREQ_HZ / 1000) * LONG_PRESS_MS > 0)
+                              ? (CLK_FREQ_HZ / 1000) * LONG_PRESS_MS : 1;
+localparam integer DB_BITS = $clog2(DB_CYCLES + 4);
+localparam integer HOLD_BITS = (HOLD_CYCLES < 2) ? 1 : $clog2(HOLD_CYCLES + 1);
+
+reg [1:0] key_meta, key_sync, stable;
+reg [DB_BITS-1:0] db_count [0:1];
+reg [HOLD_BITS-1:0] hold_count [0:1];
+reg [1:0] pressed, long_fired;
+reg blocked;
+reg [DB_BITS-1:0] release_count;
+integer k;
+
+// Include synchronized raw state so auto play pauses during debounce as well.
+assign interaction_active = blocked || (key_sync != 2'b11) || (stable != 2'b11);
+
+always @(posedge clk or posedge rst) begin
+    if (rst) begin
+        key_meta <= 2'b11;
+        key_sync <= 2'b11;
+        stable <= 2'b11;
+        for (k = 0; k < 2; k = k + 1)
+            db_count[k] <= 0;
+    end else begin
+        key_meta <= {key2_n, key1_n};
+        key_sync <= key_meta;
+        for (k = 0; k < 2; k = k + 1) begin
+            if (key_sync[k] == stable[k])
+                db_count[k] <= 0;
+            else if (db_count[k] >= DB_CYCLES - 1) begin
+                stable[k] <= key_sync[k];
+                db_count[k] <= 0;
+            end else
+                db_count[k] <= db_count[k] + 1'b1;
+        end
+    end
+end
+
+integer j;
+always @(posedge clk or posedge rst) begin
+    if (rst) begin
+        next_event <= 0;
+        prev_event <= 0;
+        toggle_auto_event <= 0;
+        cycle_period_event <= 0;
+        pressed <= 0;
+        long_fired <= 0;
+        blocked <= 1;
+        release_count <= 0;
+        for (j = 0; j < 2; j = j + 1)
+            hold_count[j] <= 0;
+    end else begin
+        next_event <= 0;
+        prev_event <= 0;
+        toggle_auto_event <= 0;
+        cycle_period_event <= 0;
+
+        // Power-on/overlap guard: release both keys before accepting another gesture.
+        if (blocked || stable == 2'b00) begin
+            blocked <= 1;
+            pressed <= 0;
+            long_fired <= 0;
+            hold_count[0] <= 0;
+            hold_count[1] <= 0;
+            // Require an additional released window after the synchronizer fills.
+            if (key_sync == 2'b11 && stable == 2'b11) begin
+                if (release_count >= DB_CYCLES + 2) begin
+                    blocked <= 0;
+                    release_count <= 0;
+                end else
+                    release_count <= release_count + 1'b1;
+            end else
+                release_count <= 0;
+        end else begin
+            release_count <= 0;
+            for (j = 0; j < 2; j = j + 1) begin
+                if (!stable[j]) begin
+                    pressed[j] <= 1;
+                    if (!long_fired[j]) begin
+                        if (hold_count[j] >= HOLD_CYCLES - 1) begin
+                            long_fired[j] <= 1;
+                            if (j == 0) cycle_period_event <= 1;
+                            else prev_event <= 1;
+                        end else
+                            hold_count[j] <= hold_count[j] + 1'b1;
+                    end
+                end else begin
+                    if (pressed[j] && !long_fired[j]) begin
+                        if (j == 0) next_event <= 1;
+                        else toggle_auto_event <= 1;
+                    end
+                    pressed[j] <= 0;
+                    long_fired[j] <= 0;
+                    hold_count[j] <= 0;
+                end
+            end
+        end
+    end
+end
+endmodule
--- before/src/user_source/hdl_source/player_status_display.v
+++ after/src/user_source/hdl_source/player_status_display.v
@@ -0,0 +1,49 @@
+// Segment encoding follows the existing six-digit board constraints.
+// Slot 0..5: picture, count, A/H, period tens, period units, source state.
+// Picture dot = image loading; source state dot = scan finished with no pictures.
+module player_status_display(
+    input wire display_valid,
+    input wire scan_complete,
+    input wire loading,
+    input wire [2:0] picture_number,
+    input wire [2:0] picture_count,
+    input wire auto_enabled,
+    input wire [3:0] period_seconds,
+    input wire [3:0] source_state,
+    output wire [7:0] digit0,
+    output wire [7:0] digit1,
+    output wire [7:0] digit2,
+    output wire [7:0] digit3,
+    output wire [7:0] digit4,
+    output wire [7:0] digit5
+);
+function [6:0] hex_segments;
+    input [3:0] value;
+    begin
+        case (value)
+            0: hex_segments = 7'b1000000;
+            1: hex_segments = 7'b1111001;
+            2: hex_segments = 7'b0100100;
+            3: hex_segments = 7'b0110000;
+            4: hex_segments = 7'b0011001;
+            5: hex_segments = 7'b0010010;
+            6: hex_segments = 7'b0000010;
+            7: hex_segments = 7'b1111000;
+            8: hex_segments = 7'b0000000;
+            9: hex_segments = 7'b0010000;
+            10: hex_segments = 7'b0001000;
+            11: hex_segments = 7'b0000011;
+            12: hex_segments = 7'b1000110;
+            13: hex_segments = 7'b0100001;
+            14: hex_segments = 7'b0000110;
+            default: hex_segments = 7'b0001110;
+        endcase
+    end
+endfunction
+assign digit0 = {~loading, display_valid ? hex_segments({1'b0, picture_number}) : 7'b0111111};
+assign digit1 = {1'b1, hex_segments({1'b0, picture_count})};
+assign digit2 = {1'b1, auto_enabled ? 7'b0001000 : 7'b0001001}; // A / H(hand)
+assign digit3 = {1'b1, hex_segments(period_seconds == 10 ? 4'd1 : 4'd0)};
+assign digit4 = {1'b1, hex_segments(period_seconds == 10 ? 4'd0 : period_seconds)};
+assign digit5 = {~(scan_complete && picture_count == 0), hex_segments(source_state)};
+endmodule
